% neurips_2024.sty - NeurIPS 2024 style file for LaTeX2e
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2024}[2024/03/14 NeurIPS 2024 style file]

\RequirePackage{ifthen}

\newboolean{neuripsfinal}
\setboolean{neuripsfinal}{false}
\DeclareOption{final}{\setboolean{neuripsfinal}{true}}

\newboolean{neuripspreprint}
\setboolean{neuripspreprint}{true}
\DeclareOption{preprint}{\setboolean{neuripspreprint}{true}}

\newboolean{nonatbib}
\setboolean{nonatbib}{false}
\DeclareOption{nonatbib}{\setboolean{nonatbib}{true}}

\ProcessOptions\relax

\ifcase\@ptsize
    \PackageWarning{neurips_2024}{Option 10pt is strongly recommended}
\or
    \PackageWarning{neurips_2024}{Option 11pt is not recommended}
\or
    \PackageWarning{neurips_2024}{Option 12pt is not recommended}
\fi

\setlength{\paperheight}{11in}
\setlength{\paperwidth}{8.5in}

\setlength{\textwidth}{5.5in}
\setlength{\textheight}{9.0in}

\setlength{\evensidemargin}{1.5in}
\setlength{\oddsidemargin}{1.5in}
\addtolength{\evensidemargin}{-1.0in}
\addtolength{\oddsidemargin}{-1.0in}

\setlength{\topmargin}{1.0in}
\addtolength{\topmargin}{-1.0in}
\setlength{\headheight}{0pt}
\setlength{\headsep}{0pt}
\setlength{\footskip}{0.4in}

\renewenvironment{abstract}%
{%
  \vskip 0.075in%
  \centerline%
  {\large\bf Abstract}%
  \vspace{0.5ex}%
  \begin{quote}%
}
{
  \par%
  \end{quote}%
  \vskip 1ex%
}

\renewcommand{\normalsize}{\@setfontsize\normalsize\@xpt\@xiipt}
\renewcommand{\small}{\@setfontsize\small\@ixpt\@xipt}
\renewcommand{\footnotesize}{\@setfontsize\footnotesize\@viiipt{9.5}}
\renewcommand{\scriptsize}{\@setfontsize\scriptsize\@viipt\@viiipt}
\renewcommand{\tiny}{\@setfontsize\tiny\@vpt\@vipt}
\renewcommand{\large}{\@setfontsize\large\@xiipt\@xivpt}
\renewcommand{\Large}{\@setfontsize\Large\@xivpt\@xvipt}
\renewcommand{\LARGE}{\@setfontsize\LARGE\@xviipt\@xxpt}
\renewcommand{\huge}{\@setfontsize\huge\@xxpt\@xxvpt}
\renewcommand{\Huge}{\@setfontsize\Huge\@xxvpt\@xxxpt}

\normalsize

\def\maketitle{%
  \par
  \begingroup
    \renewcommand{\thefootnote}{\fnsymbol{footnote}}%
    \def\@makefnmark{\hbox to\z@{$\m@th^{\@thefnmark}$\hss}}%
    \long\def\@makefntext##1{\parindent 1em\noindent
            \hb@xt@1.8em{%
                \hss\@textsuperscript{\normalfont\@thefnmark}}##1}%
    \if@twocolumn
      \ifnum \col@number=\@ne
        \@maketitle
      \else
        \twocolumn[\@maketitle]%
      \fi
    \else
      \newpage
      \global\@topnum\z@
      \@maketitle
    \fi
    \thispagestyle{plain}\@thanks
  \endgroup
  \setcounter{footnote}{0}%
  \let\maketitle\relax
  \let\@maketitle\relax
  \gdef\@thanks{}\gdef\@author{}\gdef\@title{}
}

\def\@maketitle{%
  \vbox to \z@{\vskip -0.4in
    \hbox to \textwidth{%
      \hfil
    }%
    \vss
  }%
  \vskip 0.2in
  \begin{center}%
    {\LARGE\bf \@title \par}%
    \vskip 0.15in%
    {\large
      \lineskip .5em%
      \begin{tabular}[t]{c}%
        \@author
      \end{tabular}\par}%
  \end{center}%
  \par
  \vskip 0.1in
}

\renewcommand{\section}{\@startsection{section}{1}{\z@}%
                       {-2.0ex plus -0.5ex minus -.2ex}%
                       {1.5ex plus 0.3ex minus .2ex}%
                       {\large\bf\raggedright}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
                          {-1.8ex plus -0.5ex minus -.2ex}%
                          {0.8ex plus .2ex}%
                          {\normalsize\bf\raggedright}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
                          {-1.5ex plus -0.5ex minus -.2ex}%
                          {0.5ex plus .2ex}%
                          {\normalsize\bf\raggedright}}
\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}%
                         {1.25ex \@plus1ex \@minus.2ex}%
                         {-1em}%
                         {\normalsize\bf}}
\renewcommand{\subparagraph}{\@startsection{subparagraph}{5}{\parindent}%
                            {1.25ex \@plus1ex \@minus .2ex}%
                            {-1em}%
                            {\normalsize\bf}}

\setlength{\floatsep}{10pt plus 2pt minus 2pt}
\setlength{\textfloatsep}{14pt plus 2pt minus 4pt}
\setlength{\intextsep}{10pt plus 2pt minus 2pt}
\setlength{\dblfloatsep}{10pt plus 2pt minus 2pt}
\setlength{\dbltextfloatsep}{14pt plus 2pt minus 4pt}

\setlength{\abovedisplayskip}{6pt plus 2pt minus 2pt}
\setlength{\belowdisplayskip}{6pt plus 2pt minus 2pt}
\setlength{\abovedisplayshortskip}{0pt plus 2pt}
\setlength{\belowdisplayshortskip}{4pt plus 2pt minus 2pt}

